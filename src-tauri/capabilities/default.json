{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "pake-capability",
  "description": "Capability for the pake app.",
  "webviews": [
    "pake",
    "pake-*"
  ],
  "remote": {
    "urls": [
      "https://fnos.tail5954c0.ts.net/*"
    ]
  },
  "permissions": [
    "allow-download-file",
    "allow-send-notification",
    "allow-close-notification",
    "allow-increment-dock-badge",
    "allow-set-dock-badge",
    "allow-set-dock-badge-label",
    "allow-clear-dock-badge",
    "allow-update-theme-mode",
    "allow-set-zoom",
    "allow-webview-navigate",
    "allow-set-title-bar-color",
    "allow-reveal-download",
    "allow-open-window",
    "allow-open-external",
    "shell:allow-open",
    "core:window:allow-theme",
    "core:window:allow-start-dragging",
    "core:window:allow-toggle-maximize",
    "core:window:allow-is-fullscreen",
    "core:window:allow-set-fullscreen",
    "core:window:allow-set-resizable",
    "core:window:allow-maximize",
    "core:window:allow-minimize",
    "core:window:allow-close",
    "core:window:allow-destroy",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:webview:allow-internal-toggle-devtools",
    "core:webview:allow-print",
    "notification:allow-is-permission-granted",
    "notification:allow-notify",
    "notification:allow-get-active",
    "notification:allow-register-listener",
    "notification:allow-register-action-types",
    "notification:default",
    "core:path:default"
  ]
}
